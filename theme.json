{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "720px", "wideSize": "1200px" },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#0b1220" },
        { "slug": "paper", "name": "Paper", "color": "#ffffff" },
        { "slug": "mist", "name": "Mist", "color": "#f3f6fb" },
        { "slug": "ocean", "name": "Ocean", "color": "#2563eb" },
        { "slug": "aqua", "name": "Aqua", "color": "#22d3ee" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        { "slug": "system", "name": "System", "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "base", "name": "Base", "size": "1.0625rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
        { "slug": "xl", "name": "XL", "size": "2.5rem", "fluid": { "min": "1.875rem", "max": "2.75rem" } },
        { "slug": "xxl", "name": "XXL", "size": "4.5rem", "fluid": { "min": "2.5rem", "max": "4.5rem" } }
      ]
    },
    "spacing": {
      "spacingSizes": [
        { "slug": "30", "name": "S", "size": "0.75rem" },
        { "slug": "50", "name": "M", "size": "clamp(1rem, 2vw, 1.5rem)" },
        { "slug": "70", "name": "L", "size": "clamp(3rem, 6vw, 5rem)" },
        { "slug": "90", "name": "XL", "size": "clamp(4rem, 10vw, 8rem)" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--system)", "fontSize": "var(--wp--preset--font-size--base)", "lineHeight": "1.7" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--ocean)" } },
      "heading": { "typography": { "fontWeight": "800", "lineHeight": "1.1", "letterSpacing": "-0.03em" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--ocean)", "text": "var(--wp--preset--color--paper)" },
        "border": { "radius": "999px" },
        "typography": { "fontWeight": "600" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
